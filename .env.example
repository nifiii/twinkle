# ================================
# 闪闪 环境变量
# 复制此文件: cp .env.example .env && vim .env
# 此文件位于项目根目录，已加入 .gitignore，不会被提交
# ================================
# === 运行时 ===
NODE_ENV=production
PORT=3000
DATA_DIR=/opt/twinkle/data

# === 火山引擎豆包（OCR / 课件 / 测验） ===
# 申请: https://console.volcengine.com/ark/region:ark+cn-beijing/endpoint
ARK_API_KEY=
ARK_MODEL_ID=

# OCR 视觉模型 endpoint id；未配置时回退到 ARK_MODEL_ID
ARK_VISION_MODEL_ID=

# === 火山引擎 TTS（语音合成） ===
VOLCANO_TTS_API_KEY=
VOLCANO_TTS_RESOURCE_ID=seed-tts-2.0
VOLCANO_TTS_CLUSTER=volcano_mega
VOLCANO_TTS_VOICE_TYPE=zh_female_shuangkuai_emo_bigtts

# === 豆包端到端实时语音（仅服务端使用，浏览器不可配置） ===
# 启用前需在火山引擎实时语音服务中创建应用并配置下列凭据。
LIVE_TUTOR_DOUBAO_ENABLED=false
DOUBAO_REALTIME_APP_ID=
DOUBAO_REALTIME_ACCESS_TOKEN=
# The Realtime API uses its documented fixed X-Api-App-Key; do not put the console Secret Key here.
DOUBAO_REALTIME_RESOURCE_ID=volc.speech.dialog
DOUBAO_REALTIME_MODEL=1.2.1.1
DOUBAO_REALTIME_VAD_END_SMOOTH_WINDOW_MS=700
DOUBAO_REALTIME_MAX_SESSIONS=3
DOUBAO_REALTIME_MAX_SESSION_MS=1200000
DOUBAO_REALTIME_MAX_FRAMES_PER_SECOND=80

# === 教材驱动学习（首期仅限受信任单设备） ===
# ownerId 仅用于本地资料切换，不是登录或服务端授权。每项能力默认关闭，
# 仅在对应路由已完成验收后显式开启。
LEARNING_PACKAGES_ENABLED=false
LEARNING_ASSESSMENTS_ENABLED=false
LEARNING_ATTEMPTS_ENABLED=false
LEARNING_GRADING_ENABLED=false
LEARNING_EXPORTS_ENABLED=false
